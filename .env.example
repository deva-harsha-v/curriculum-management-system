# Environment Configuration Template for Curriculum Management System
# Copy this file to .env and customize values for your deployment.

# Django Security Key (generate a secure random 50+ character string for production)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated list of hostnames/domain names)
ALLOWED_HOSTS=127.0.0.1,localhost,yourusername.pythonanywhere.com

# CSRF Trusted Origins (comma-separated list of schemes and hostnames)
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com,http://127.0.0.1,http://localhost

# Institutional Branding (optional - defaults to Curriculum Management System)
INSTITUTION_NAME=Curriculum Management System

# HTTPS / Cookie Security (set to True when deployed with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO
